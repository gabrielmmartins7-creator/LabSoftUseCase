@model AppTask.Models.Departamento

@{
    ViewData["Title"] = "Cadastrar Departamento";
}

<div class="container mt-4">
    <h2>Cadastrar Departamento</h2>

    <form action="/Departamento/Create" method="post">
        @Html.AntiForgeryToken()

        <div class="mb-3">
            <label for="Descricao" class="form-label">Descrição</label>
            <input type="text"
                   id="Descricao"
                   name="Descricao"
                   class="form-control"
                   maxlength="250"
                   value="@Model?.Descricao"
                   required />
        </div>

        <div class="form-check mb-3">
            <input type="checkbox"
                   id="Ativo"
                   name="Ativo"
                   value="true"
                   class="form-check-input"
                   checked="@(Model?.Ativo == true)" />
            <label for="Ativo" class="form-check-label">
                Departamento ativo
            </label>
        </div>

        <button type="submit" class="btn btn-success">Salvar</button>
        <a href="/Departamento" class="btn btn-secondary">Voltar</a>
    </form>
</div>
