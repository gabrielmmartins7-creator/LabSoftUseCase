@model AppTask.Models.CentralDeCusto

@{
    ViewData["Title"] = "Cadastrar Central de Custo";
}

<div class="container mt-4">
    <h2>Cadastrar Central de Custo</h2>

    <form action="/CentralDeCusto/Create" method="post">
        @Html.AntiForgeryToken()

        <div class="row">
            <div class="col-md-6 mb-3">
                <label for="NomeCentral" class="form-label">
                    Nome da Central
                </label>
                <input type="text"
                       id="NomeCentral"
                       name="NomeCentral"
                       class="form-control"
                       maxlength="250"
                       value="@Model?.NomeCentral"
                       required />
            </div>

            <div class="col-md-6 mb-3">
                <label for="ValorMetaAnual" class="form-label">
                    Valor da Meta Anual
                </label>
                <input type="number"
                       id="ValorMetaAnual"
                       name="ValorMetaAnual"
                       class="form-control"
                       min="0"
                       step="0.01"
                       value="@Model?.ValorMetaAnual" />
            </div>
        </div>

        <button type="submit" class="btn btn-success">Salvar</button>
        <a href="/CentralDeCusto" class="btn btn-secondary">Voltar</a>
    </form>
</div>
