@model AppTask.Models.Incidente

@{
    ViewData["Title"] = "Cadastrar Incidente";
}

<div class="container mt-4">
    <h2>Cadastrar Incidente</h2>

    <form action="/Incidente/Create" method="post">
        @Html.AntiForgeryToken()

        <div class="mb-3">
            <label for="DescricaoProblema" class="form-label">
                Descrição do problema
            </label>
            <textarea id="DescricaoProblema"
                      name="DescricaoProblema"
                      class="form-control"
                      rows="3"
                      required>@Model?.DescricaoProblema</textarea>
        </div>

        <div class="mb-3">
            <label for="DataIncidente" class="form-label">
                Data do incidente
            </label>
            <input type="datetime-local"
                   id="DataIncidente"
                   name="DataIncidente"
                   class="form-control"
                   value="@(Model?.DataIncidente.ToString("yyyy-MM-ddTHH:mm"))"
                   required />
        </div>

        <div class="mb-3">
            <label for="Solucao" class="form-label">Solução</label>
            <textarea id="Solucao"
                      name="Solucao"
                      class="form-control"
                      rows="3">@Model?.Solucao</textarea>
        </div>

        <div class="mb-3">
            <label for="Resolvido" class="form-label">Resolvido?</label>
            <select id="Resolvido" name="Resolvido"
                    class="form-select" required>
                <option value="">Selecione</option>
                <option value="Sim">Sim</option>
                <option value="Não">Não</option>
            </select>
        </div>

        <button type="submit" class="btn btn-success">
            Salvar
        </button>

        <a href="/Incidente" class="btn btn-secondary">
            Voltar
        </a>
    </form>
</div>
