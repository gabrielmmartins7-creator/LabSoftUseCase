@model AppTask.Models.Funcionario

@{
    ViewData["Title"] = "Cadastrar Funcionário";
}

<div class="container mt-4">
    <h2>Cadastrar Funcionário</h2>

    <form action="/Funcionarios/Create" method="post">
        @Html.AntiForgeryToken()

        <div class="mb-3">
            <label for="Nome" class="form-label">Nome</label>
            <input type="text"
                   id="Nome"
                   name="Nome"
                   class="form-control"
                   value="@Model?.Nome"
                   required />
        </div>

        <div class="mb-3">
            <label for="Cargo" class="form-label">Cargo</label>
            <input type="text"
                   id="Cargo"
                   name="Cargo"
                   class="form-control"
                   value="@Model?.Cargo"
                   required />
        </div>

        <button type="submit" class="btn btn-success">
            Salvar
        </button>

        <a href="/Funcionarios" class="btn btn-secondary">
            Voltar
        </a>
    </form>
</div>
